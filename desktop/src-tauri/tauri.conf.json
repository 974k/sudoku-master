{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sudoku Master",
  "version": "../package.json",
  "identifier": "app.sudokumaster.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sudoku Master",
        "width": 1120,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'self'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Sudoku Master",
    "shortDescription": "Ad-free, offline Sudoku",
    "copyright": "Free and ad-free. No data collection.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzQUNGMjUxMTZCQzRDRTIKUldUaVRMd1dVZktzWXlVbGlzS29HRGxQcWlob0RLQmo4V1BTUjhWSjF5amxuRzNGNzA3ZEtQUkMK",
      "endpoints": ["https://github.com/974k/sudoku-master/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
